{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lotheleddie-site",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "coventrysystems.cloudflareaccess.com",
    "ACCESS_AUD": "92af482b41ed243a829f7a1118465c976b5c02febd1b3b66bb7278453819f67f"
  },
  "kv_namespaces": [
    {
      "binding": "CONTENT_KV",
      "id": "220dabf5bab04df78b9bc9f72da6203b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "lothel-eddie-public"
    }
  ]
}
